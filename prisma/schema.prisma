generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum TripStatus {
  DRAFT
  PLANNING
  ARCHIVED
}

enum BudgetLevel {
  BUDGET
  MODERATE
  LUXURY
}

enum TravelPace {
  RELAXED
  BALANCED
  PACKED
}

enum TripLogisticsMode {
  FLEXIBLE
  TICKETED
}

enum TravelSegmentMode {
  FLIGHT
  TRAIN
  BUS
  CAR
  FERRY
  OTHER
}

enum CityWindowSource {
  FLEXIBLE
  TICKETED
}

enum TransportationMode {
  WALKING
  PUBLIC_TRANSIT
  RIDE_SHARE
  RENTAL_CAR
  MIXED
}

enum AccommodationType {
  HOSTEL
  HOTEL
  RESORT
  AIRBNB
  OTHER
}

enum Provider {
  MOCK
  GOOGLE_PLACES
  GEMINI
  USER
}

enum SuggestionCategory {
  DESTINATION
  HOTEL
  ATTRACTION
  RESTAURANT
  ACTIVITY
  LANDMARK
  ENTERTAINMENT
}

enum SuggestionStatus {
  PENDING
  SELECTED
  REJECTED
}

enum PlanningActor {
  USER
  ENGINE
  SYSTEM
}

enum PlanningEventType {
  USER_FEEDBACK
  ENGINE_EXPLANATION
  READINESS_WARNING
  RECOMMENDATION_BATCH
  ITINERARY_PROPOSAL
  BUDGET_WARNING
  CONFLICT_SUMMARY
  SYSTEM_NOTE
}

enum FeedbackTargetType {
  TRIP
  PREFERENCE
  PLACE_SUGGESTION
  ITINERARY_DAY
  ITINERARY_ITEM
  CONFLICT
}

enum FeedbackAction {
  ACCEPT
  REJECT
  REFRESH
  REFINE
  SELECT
  DESELECT
  IGNORE
  RESOLVE
  REQUEST_ALTERNATIVE
}

enum FeedbackReason {
  NOT_INTERESTED
  TOO_EXPENSIVE
  TOO_FAR
  WRONG_VIBE
  ALREADY_BEEN_THERE
  TOO_BUSY
  TOO_SLOW
  GOOD_MATCH
  OTHER
}

enum ConflictType {
  TIME
  DISTANCE
  BUDGET
  SCHEDULE_DENSITY
  HOTEL_LOCATION
  MISSING_DURATION
  CLOSED_OR_UNAVAILABLE
}

enum ConflictSeverity {
  LOW
  MEDIUM
  HIGH
}

enum ConflictStatus {
  OPEN
  RESOLVED
  IGNORED
}

enum PreferenceSignalSource {
  EXPLICIT
  INFERRED
  DEFAULT
}

enum FeedbackProcessingStatus {
  RECORDED
  QUEUED
  PROCESSING
  PROCESSED
  FAILED
  SUPERSEDED
}

enum ItineraryVersionStatus {
  DRAFT
  ACTIVE
  SUPERSEDED
  FAILED
}

enum ItineraryChangeScope {
  INITIAL
  ITEM
  DAY
  FULL
  MIGRATED
}

enum GenerationJobType {
  PROCESS_FEEDBACK_EVENT
}

enum GenerationJobStatus {
  PENDING
  RUNNING
  RETRYING
  SUCCEEDED
  FAILED
  DEAD_LETTERED
  SUPERSEDED
}

enum JobAttemptStatus {
  RUNNING
  SUCCEEDED
  FAILED
  ABANDONED
  SUPERSEDED
}

enum JobEventType {
  RECEIVED
  CLAIMED
  UPDATING_PREFERENCES
  FINDING_REPLACEMENT
  VALIDATING_ITINERARY
  RETRY_SCHEDULED
  COMPLETED
  FAILED
  DEAD_LETTERED
  SUPERSEDED
  RECOVERED
}

model User {
  id            String    @id @default(dbgenerated("(gen_random_uuid())::text"))
  name          String?
  email         String?   @unique
  emailVerified DateTime? @map("email_verified")
  image         String?
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  accounts         Account[]
  sessions         Session[]
  trips            Trip[]
  travelPreference UserTravelPreference?
  planningFeedback PlanningFeedback[]

  @@map("users")
}

model UserTravelPreference {
  id                  String               @id @default(dbgenerated("(gen_random_uuid())::text"))
  userId              String               @unique @map("user_id")
  budgetLevel         BudgetLevel?         @map("budget_level")
  pace                TravelPace?
  interests           String[]             @default([])
  transportationModes TransportationMode[] @default([]) @map("transportation_modes")
  accommodationTypes  AccommodationType[]  @default([]) @map("accommodation_types")
  hotelPriority       Int?                 @map("hotel_priority")
  walkingToleranceKm  Decimal?             @map("walking_tolerance_km") @db.Decimal(5, 2)
  dietaryRestrictions Json?                @map("dietary_restrictions")
  accessibilityNeeds  Json?                @map("accessibility_needs")
  mustAvoid           Json?                @map("must_avoid")
  customPreferences   Json?                @map("custom_preferences")
  metadata            Json?
  createdAt           DateTime             @default(now()) @map("created_at")
  updatedAt           DateTime             @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("user_travel_preferences")
}

model Account {
  id                String  @id @default(dbgenerated("(gen_random_uuid())::text"))
  userId            String  @map("user_id")
  type              String
  provider          String
  providerAccountId String  @map("provider_account_id")
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(dbgenerated("(gen_random_uuid())::text"))
  sessionToken String   @unique @map("session_token")
  userId       String   @map("user_id")
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

model Trip {
  id                    String            @id @default(dbgenerated("(gen_random_uuid())::text"))
  userId                String            @map("user_id")
  title                 String
  status                TripStatus        @default(DRAFT)
  destinationSearchText String?           @map("destination_search_text")
  departureCity         String?           @map("departure_city")
  departureCountry      String?           @map("departure_country")
  departureTimeZone     String?           @map("departure_time_zone")
  startDate             DateTime?         @map("start_date")
  endDate               DateTime?         @map("end_date")
  budgetAmount          Decimal?          @map("budget_amount") @db.Decimal(12, 2)
  budgetCurrency        String?           @map("budget_currency") @db.VarChar(3)
  logisticsMode         TripLogisticsMode @default(FLEXIBLE) @map("logistics_mode")
  planningRevision      Int               @default(0) @map("planning_revision")
  tripVersion           Int               @default(1) @map("trip_version")
  activePreferenceProfileVersionId String? @map("active_preference_profile_version_id")
  activeItineraryVersionId         String? @map("active_itinerary_version_id")
  createdAt             DateTime          @default(now()) @map("created_at")
  updatedAt             DateTime          @updatedAt @map("updated_at")

  user              User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  destinations      TripDestination[]
  travelSegments    TripTravelSegment[]
  preference        TripPreference?
  suggestions       PlaceSuggestion[]
  planningFeedback  PlanningFeedback[]
  planningEvents    PlanningEvent[]
  itineraryDays     ItineraryDay[]
  cityWindows       ItineraryCityWindow[]
  itineraryItems    ItineraryItem[]
  conflicts         Conflict[]
  planningMutations PlanningMutation[]
  preferenceProfileVersions PreferenceProfileVersion[] @relation("TripPreferenceProfileVersions")
  itineraryVersions         ItineraryVersion[]         @relation("TripItineraryVersions")
  generationJobs            GenerationJob[]
  activePreferenceProfileVersion PreferenceProfileVersion? @relation("ActivePreferenceProfileVersion", fields: [id, activePreferenceProfileVersionId], references: [tripId, id], onDelete: NoAction)
  activeItineraryVersion         ItineraryVersion?         @relation("ActiveItineraryVersion", fields: [id, activeItineraryVersionId], references: [tripId, id], onDelete: NoAction)

  @@index([userId])
  @@index([status])
  @@index([startDate, endDate])
  @@index([activePreferenceProfileVersionId])
  @@index([activeItineraryVersionId])
  @@map("trips")
}

model TripDestination {
  id        String   @id @default(dbgenerated("(gen_random_uuid())::text"))
  tripId    String   @map("trip_id")
  city      String
  country   String
  region    String?
  timeZone  String?  @map("time_zone")
  latitude  Decimal? @db.Decimal(10, 7)
  longitude Decimal? @db.Decimal(10, 7)
  sortOrder Int      @default(0) @map("sort_order")
  notes     String?  @db.Text
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  trip        Trip                  @relation(fields: [tripId], references: [id], onDelete: Cascade)
  suggestions PlaceSuggestion[]     @relation("TripDestinationPlaceSuggestions")
  cityWindows ItineraryCityWindow[] @relation("TripDestinationCityWindows")

  @@unique([tripId, id])
  @@index([tripId])
  @@index([tripId, sortOrder])
  @@map("trip_destinations")
}

model PlanningMutation {
  id                 String   @id @default(dbgenerated("(gen_random_uuid())::text"))
  tripId             String   @map("trip_id")
  operationId        String   @map("operation_id") @db.VarChar(128)
  kind               String   @db.VarChar(64)
  requestFingerprint String?  @map("request_fingerprint") @db.Char(64)
  requestedRevision  Int?     @map("requested_revision")
  resultingRevision  Int      @map("resulting_revision")
  resultVersion      Int      @default(1) @map("result_version")
  result             Json
  createdAt          DateTime @default(now()) @map("created_at")

  trip Trip @relation(fields: [tripId], references: [id], onDelete: Cascade)

  @@unique([tripId, operationId])
  @@index([tripId, createdAt])
  @@map("planning_mutations")
}

model TripTravelSegment {
  id                 String            @id @default(dbgenerated("(gen_random_uuid())::text"))
  tripId             String            @map("trip_id")
  mode               TravelSegmentMode
  originCity         String            @map("origin_city")
  originCountry      String            @map("origin_country")
  destinationCity    String            @map("destination_city")
  destinationCountry String            @map("destination_country")
  departAt           DateTime          @map("depart_at")
  arriveAt           DateTime          @map("arrive_at")
  carrier            String?
  referenceCode      String?           @map("reference_code")
  sortOrder          Int               @default(0) @map("sort_order")
  createdAt          DateTime          @default(now()) @map("created_at")
  updatedAt          DateTime          @updatedAt @map("updated_at")

  trip        Trip                  @relation(fields: [tripId], references: [id], onDelete: Cascade)
  cityWindows ItineraryCityWindow[] @relation("TravelSegmentCityWindows")

  @@unique([tripId, id])
  @@index([tripId])
  @@index([tripId, sortOrder])
  @@index([departAt, arriveAt])
  @@map("trip_travel_segments")
}

model TripPreference {
  id                  String               @id @default(dbgenerated("(gen_random_uuid())::text"))
  tripId              String               @unique @map("trip_id")
  budgetLevel         BudgetLevel?         @map("budget_level")
  pace                TravelPace?
  interests           String[]             @default([])
  transportationModes TransportationMode[] @default([]) @map("transportation_modes")
  accommodationTypes  AccommodationType[]  @default([]) @map("accommodation_types")
  hotelPriority       Int?                 @map("hotel_priority")
  walkingToleranceKm  Decimal?             @map("walking_tolerance_km") @db.Decimal(5, 2)
  dietaryRestrictions Json?                @map("dietary_restrictions")
  accessibilityNeeds  Json?                @map("accessibility_needs")
  mustAvoid           Json?                @map("must_avoid")
  customNotes         String?              @map("custom_notes") @db.Text
  metadata            Json?
  createdAt           DateTime             @default(now()) @map("created_at")
  updatedAt           DateTime             @updatedAt @map("updated_at")

  trip     Trip               @relation(fields: [tripId], references: [id], onDelete: Cascade)
  feedback PlanningFeedback[] @relation("TripPreferenceFeedback")

  @@unique([tripId, id])
  @@index([tripId])
  @@map("trip_preferences")
}

model PlaceSuggestion {
  id                    String             @id @default(dbgenerated("(gen_random_uuid())::text"))
  tripId                String             @map("trip_id")
  destinationId         String?            @map("destination_id")
  provider              Provider           @default(MOCK)
  providerPlaceId       String?            @map("provider_place_id")
  category              SuggestionCategory
  status                SuggestionStatus   @default(PENDING)
  name                  String
  description           String?            @db.Text
  explanation           String?            @db.Text
  address               String?
  city                  String?
  country               String?
  latitude              Decimal?           @db.Decimal(10, 7)
  longitude             Decimal?           @db.Decimal(10, 7)
  rating                Decimal?           @db.Decimal(3, 2)
  priceLevel            Int?               @map("price_level")
  estimatedCostAmount   Decimal?           @map("estimated_cost_amount") @db.Decimal(12, 2)
  estimatedCostCurrency String?            @map("estimated_cost_currency") @db.VarChar(3)
  score                 Decimal?           @db.Decimal(6, 2)
  rawProviderData       Json?              @map("raw_provider_data")
  metadata              Json?
  createdAt             DateTime           @default(now()) @map("created_at")
  updatedAt             DateTime           @updatedAt @map("updated_at")

  trip           Trip               @relation(fields: [tripId], references: [id], onDelete: Cascade)
  destination    TripDestination?   @relation("TripDestinationPlaceSuggestions", fields: [tripId, destinationId], references: [tripId, id], onDelete: NoAction)
  itineraryItems ItineraryItem[]    @relation("PlaceSuggestionItineraryItems")
  feedback       PlanningFeedback[] @relation("PlaceSuggestionFeedback")

  @@unique([tripId, id])
  @@unique([tripId, provider, providerPlaceId])
  @@index([tripId])
  @@index([destinationId])
  @@index([tripId, category])
  @@index([tripId, status])
  @@map("place_suggestions")
}

model PlanningFeedback {
  id                String             @id @default(dbgenerated("(gen_random_uuid())::text"))
  tripId            String             @map("trip_id")
  targetType        FeedbackTargetType @map("target_type")
  targetId          String             @map("target_id")
  source            PlanningActor      @default(USER)
  action            FeedbackAction?
  reason            FeedbackReason?
  userNote          String?            @map("user_note") @db.Text
  metadata          Json?
  tripPreferenceId  String?            @map("trip_preference_id")
  placeSuggestionId String?            @map("place_suggestion_id")
  itineraryDayId    String?            @map("itinerary_day_id")
  itineraryItemId   String?            @map("itinerary_item_id")
  conflictId        String?            @map("conflict_id")
  eventKey          String?            @map("event_key") @db.VarChar(128)
  userId            String?            @map("user_id")
  capturedTripVersion Int?             @map("captured_trip_version")
  capturedPreferenceProfileVersionId String? @map("captured_preference_profile_version_id")
  capturedItineraryVersionId String?   @map("captured_itinerary_version_id")
  processingStatus  FeedbackProcessingStatus @default(RECORDED) @map("processing_status")
  processedAt       DateTime?          @map("processed_at")
  createdAt         DateTime           @default(now()) @map("created_at")

  trip            Trip             @relation(fields: [tripId], references: [id], onDelete: Cascade)
  tripPreference  TripPreference?  @relation("TripPreferenceFeedback", fields: [tripId, tripPreferenceId], references: [tripId, id], onDelete: NoAction)
  placeSuggestion PlaceSuggestion? @relation("PlaceSuggestionFeedback", fields: [tripId, placeSuggestionId], references: [tripId, id], onDelete: NoAction)
  itineraryDay    ItineraryDay?    @relation("ItineraryDayFeedback", fields: [tripId, itineraryDayId], references: [tripId, id], onDelete: NoAction)
  itineraryItem   ItineraryItem?   @relation("ItineraryItemFeedback", fields: [tripId, itineraryItemId], references: [tripId, id], onDelete: NoAction)
  conflict        Conflict?        @relation("ConflictFeedback", fields: [tripId, conflictId], references: [tripId, id], onDelete: NoAction)
  user            User?            @relation(fields: [userId], references: [id], onDelete: SetNull)
  preferenceUpdate PreferenceProfileVersion? @relation("FeedbackPreferenceUpdate")
  capturedPreferenceProfileVersion PreferenceProfileVersion? @relation("FeedbackCapturedPreferenceProfileVersion", fields: [tripId, capturedPreferenceProfileVersionId], references: [tripId, id], onDelete: NoAction)
  capturedItineraryVersion ItineraryVersion? @relation("FeedbackCapturedItineraryVersion", fields: [tripId, capturedItineraryVersionId], references: [tripId, id], onDelete: NoAction)
  generationJobs   GenerationJob[]

  @@unique([tripId, id])
  @@unique([tripId, eventKey])
  @@index([tripId])
  @@index([targetType])
  @@index([targetType, targetId])
  @@index([tripPreferenceId])
  @@index([placeSuggestionId])
  @@index([itineraryDayId])
  @@index([itineraryItemId])
  @@index([conflictId])
  @@index([userId])
  @@index([processingStatus])
  @@map("planning_feedback")
}

model PreferenceProfileVersion {
  id               String   @id @default(dbgenerated("(gen_random_uuid())::text"))
  tripId           String   @map("trip_id")
  version          Int
  parentVersionId  String?  @map("parent_version_id")
  sourceFeedbackId String?  @map("source_feedback_id")
  snapshot         Json
  delta            Json?
  createdAt        DateTime @default(now()) @map("created_at")

  trip           Trip                      @relation("TripPreferenceProfileVersions", fields: [tripId], references: [id], onDelete: Cascade)
  activeForTrips Trip[]                    @relation("ActivePreferenceProfileVersion")
  parent         PreferenceProfileVersion? @relation("PreferenceProfileVersionParent", fields: [tripId, parentVersionId], references: [tripId, id], onDelete: NoAction)
  children       PreferenceProfileVersion[] @relation("PreferenceProfileVersionParent")
  sourceFeedback PlanningFeedback?         @relation("FeedbackPreferenceUpdate", fields: [tripId, sourceFeedbackId], references: [tripId, id], onDelete: NoAction)
  capturedByFeedback PlanningFeedback[]    @relation("FeedbackCapturedPreferenceProfileVersion")
  itineraryVersions ItineraryVersion[]
  generationJobs GenerationJob[] @relation("JobPreferenceProfileVersion")

  @@unique([tripId, id])
  @@unique([tripId, version])
  @@unique([tripId, sourceFeedbackId])
  @@index([tripId, createdAt])
  @@index([parentVersionId])
  @@map("preference_profile_versions")
}

model ItineraryVersion {
  id                         String                 @id @default(dbgenerated("(gen_random_uuid())::text"))
  tripId                     String                 @map("trip_id")
  version                    Int
  parentVersionId            String?                @map("parent_version_id")
  preferenceProfileVersionId String?                @map("preference_profile_version_id")
  sourceJobId                String?                @map("source_job_id")
  status                     ItineraryVersionStatus @default(DRAFT)
  changeScope                ItineraryChangeScope   @default(FULL) @map("change_scope")
  changeSummary              Json?                  @map("change_summary")
  activatedAt                DateTime?              @map("activated_at")
  createdAt                  DateTime               @default(now()) @map("created_at")

  trip                     Trip                      @relation("TripItineraryVersions", fields: [tripId], references: [id], onDelete: Cascade)
  activeForTrips           Trip[]                    @relation("ActiveItineraryVersion")
  parent                   ItineraryVersion?         @relation("ItineraryVersionParent", fields: [tripId, parentVersionId], references: [tripId, id], onDelete: NoAction)
  children                 ItineraryVersion[]        @relation("ItineraryVersionParent")
  preferenceProfileVersion PreferenceProfileVersion? @relation(fields: [tripId, preferenceProfileVersionId], references: [tripId, id], onDelete: NoAction)
  sourceJob                GenerationJob?            @relation("JobProducedItineraryVersion", fields: [tripId, sourceJobId], references: [tripId, id], onDelete: NoAction)
  capturedByFeedback       PlanningFeedback[]        @relation("FeedbackCapturedItineraryVersion")
  days                     ItineraryDay[]
  conflicts                Conflict[]
  generationJobs           GenerationJob[] @relation("JobParentItineraryVersion")

  @@unique([tripId, id])
  @@unique([tripId, version])
  @@unique([tripId, sourceJobId])
  @@index([tripId, status, createdAt])
  @@index([parentVersionId])
  @@index([preferenceProfileVersionId])
  @@map("itinerary_versions")
}

model GenerationJob {
  id                         String              @id @default(dbgenerated("(gen_random_uuid())::text"))
  tripId                     String              @map("trip_id")
  feedbackId                 String?             @map("feedback_id")
  type                       GenerationJobType
  status                     GenerationJobStatus @default(PENDING)
  idempotencyKey             String              @map("idempotency_key") @db.VarChar(128)
  tripVersion                Int                 @map("trip_version")
  preferenceProfileVersionId String?             @map("preference_profile_version_id")
  parentItineraryVersionId   String?             @map("parent_itinerary_version_id")
  payload                    Json
  result                     Json?
  progress                   Int                 @default(0)
  progressMessage            String?             @map("progress_message") @db.VarChar(240)
  attemptCount               Int                 @default(0) @map("attempt_count")
  maxAttempts                Int                 @default(3) @map("max_attempts")
  availableAt                DateTime            @default(now()) @map("available_at")
  claimedAt                  DateTime?           @map("claimed_at")
  heartbeatAt                DateTime?           @map("heartbeat_at")
  leaseExpiresAt             DateTime?           @map("lease_expires_at")
  workerId                   String?             @map("worker_id") @db.VarChar(128)
  completedAt                DateTime?           @map("completed_at")
  errorCode                  String?             @map("error_code") @db.VarChar(64)
  errorMessage               String?             @map("error_message") @db.VarChar(500)
  createdAt                  DateTime            @default(now()) @map("created_at")
  updatedAt                  DateTime            @updatedAt @map("updated_at")

  trip                     Trip                      @relation(fields: [tripId], references: [id], onDelete: Cascade)
  feedback                 PlanningFeedback?         @relation(fields: [tripId, feedbackId], references: [tripId, id], onDelete: NoAction)
  preferenceProfileVersion PreferenceProfileVersion? @relation("JobPreferenceProfileVersion", fields: [tripId, preferenceProfileVersionId], references: [tripId, id], onDelete: NoAction)
  parentItineraryVersion   ItineraryVersion?         @relation("JobParentItineraryVersion", fields: [tripId, parentItineraryVersionId], references: [tripId, id], onDelete: NoAction)
  producedItineraryVersion ItineraryVersion?         @relation("JobProducedItineraryVersion")
  attempts                 JobAttempt[]
  events                   JobEvent[]

  @@unique([tripId, id])
  @@unique([tripId, idempotencyKey])
  @@index([status, availableAt])
  @@index([status, leaseExpiresAt])
  @@index([tripId, createdAt])
  @@index([feedbackId])
  @@map("generation_jobs")
}

model JobAttempt {
  id          String           @id @default(dbgenerated("(gen_random_uuid())::text"))
  jobId       String           @map("job_id")
  attempt     Int
  status      JobAttemptStatus @default(RUNNING)
  workerId    String           @map("worker_id") @db.VarChar(128)
  startedAt   DateTime         @default(now()) @map("started_at")
  heartbeatAt DateTime?        @map("heartbeat_at")
  completedAt DateTime?        @map("completed_at")
  errorCode   String?          @map("error_code") @db.VarChar(64)
  errorMessage String?         @map("error_message") @db.VarChar(500)

  job GenerationJob @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@unique([jobId, attempt])
  @@index([jobId, startedAt])
  @@map("job_attempts")
}

model JobEvent {
  id        String       @id @default(dbgenerated("(gen_random_uuid())::text"))
  jobId     String       @map("job_id")
  type      JobEventType
  progress  Int?
  message   String?      @db.VarChar(240)
  metadata  Json?
  createdAt DateTime     @default(now()) @map("created_at")

  job GenerationJob @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@index([jobId, createdAt])
  @@map("job_events")
}

model PlanningEvent {
  id            String            @id @default(dbgenerated("(gen_random_uuid())::text"))
  tripId        String            @map("trip_id")
  actor         PlanningActor
  type          PlanningEventType
  title         String
  message       String?           @db.Text
  visibleToUser Boolean           @default(true) @map("visible_to_user")
  metadata      Json?
  createdAt     DateTime          @default(now()) @map("created_at")

  trip Trip @relation(fields: [tripId], references: [id], onDelete: Cascade)

  @@index([tripId])
  @@index([actor])
  @@index([type])
  @@index([createdAt])
  @@map("planning_events")
}

model ItineraryDay {
  id                    String    @id @default(dbgenerated("(gen_random_uuid())::text"))
  tripId                String    @map("trip_id")
  itineraryVersionId    String    @map("itinerary_version_id")
  dayNumber             Int       @map("day_number")
  date                  DateTime?
  title                 String?
  notes                 String?   @db.Text
  estimatedCostAmount   Decimal?  @map("estimated_cost_amount") @db.Decimal(12, 2)
  estimatedCostCurrency String?   @map("estimated_cost_currency") @db.VarChar(3)
  createdAt             DateTime  @default(now()) @map("created_at")
  updatedAt             DateTime  @updatedAt @map("updated_at")

  trip        Trip                  @relation(fields: [tripId], references: [id], onDelete: Cascade)
  itineraryVersion ItineraryVersion @relation(fields: [tripId, itineraryVersionId], references: [tripId, id], onDelete: Cascade)
  items       ItineraryItem[]       @relation("ItineraryDayItems")
  cityWindows ItineraryCityWindow[] @relation("ItineraryDayCityWindows")
  feedback    PlanningFeedback[]    @relation("ItineraryDayFeedback")

  @@unique([itineraryVersionId, dayNumber])
  @@unique([tripId, id])
  @@index([tripId])
  @@index([itineraryVersionId])
  @@map("itinerary_days")
}

model ItineraryCityWindow {
  id              String           @id @default(dbgenerated("(gen_random_uuid())::text"))
  tripId          String           @map("trip_id")
  dayId           String           @map("day_id")
  destinationId   String?          @map("destination_id")
  travelSegmentId String?          @map("travel_segment_id")
  city            String
  country         String
  startTime       DateTime         @map("start_time")
  endTime         DateTime         @map("end_time")
  source          CityWindowSource
  createdAt       DateTime         @default(now()) @map("created_at")

  trip          Trip               @relation(fields: [tripId], references: [id], onDelete: Cascade)
  day           ItineraryDay       @relation("ItineraryDayCityWindows", fields: [tripId, dayId], references: [tripId, id], onDelete: Cascade)
  destination   TripDestination?   @relation("TripDestinationCityWindows", fields: [tripId, destinationId], references: [tripId, id], onDelete: NoAction)
  travelSegment TripTravelSegment? @relation("TravelSegmentCityWindows", fields: [tripId, travelSegmentId], references: [tripId, id], onDelete: NoAction)

  @@unique([tripId, id])
  @@index([tripId])
  @@index([dayId])
  @@index([destinationId])
  @@index([travelSegmentId])
  @@index([startTime, endTime])
  @@map("itinerary_city_windows")
}

model ItineraryItem {
  id                    String    @id @default(dbgenerated("(gen_random_uuid())::text"))
  tripId                String    @map("trip_id")
  dayId                 String    @map("day_id")
  placeSuggestionId     String?   @map("place_suggestion_id")
  title                 String
  description           String?   @db.Text
  startTime             DateTime? @map("start_time")
  endTime               DateTime? @map("end_time")
  durationMinutes       Int?      @map("duration_minutes")
  sortOrder             Int       @default(0) @map("sort_order")
  estimatedCostAmount   Decimal?  @map("estimated_cost_amount") @db.Decimal(12, 2)
  estimatedCostCurrency String?   @map("estimated_cost_currency") @db.VarChar(3)
  notes                 String?   @db.Text
  createdAt             DateTime  @default(now()) @map("created_at")
  updatedAt             DateTime  @updatedAt @map("updated_at")

  trip            Trip               @relation(fields: [tripId], references: [id], onDelete: Cascade)
  day             ItineraryDay       @relation("ItineraryDayItems", fields: [tripId, dayId], references: [tripId, id], onDelete: Cascade)
  placeSuggestion PlaceSuggestion?   @relation("PlaceSuggestionItineraryItems", fields: [tripId, placeSuggestionId], references: [tripId, id], onDelete: NoAction)
  conflicts       Conflict[]         @relation("ItineraryItemConflicts")
  feedback        PlanningFeedback[] @relation("ItineraryItemFeedback")

  @@unique([tripId, id])
  @@index([tripId])
  @@index([dayId])
  @@index([placeSuggestionId])
  @@index([dayId, sortOrder])
  @@map("itinerary_items")
}

model Conflict {
  id              String           @id @default(dbgenerated("(gen_random_uuid())::text"))
  tripId          String           @map("trip_id")
  itineraryItemId String?          @map("itinerary_item_id")
  itineraryVersionId String        @map("itinerary_version_id")
  type            ConflictType
  severity        ConflictSeverity
  status          ConflictStatus   @default(OPEN)
  message         String           @db.Text
  recommendation  String?          @db.Text
  metadata        Json?
  createdAt       DateTime         @default(now()) @map("created_at")
  updatedAt       DateTime         @updatedAt @map("updated_at")

  trip          Trip               @relation(fields: [tripId], references: [id], onDelete: Cascade)
  itineraryVersion ItineraryVersion @relation(fields: [tripId, itineraryVersionId], references: [tripId, id], onDelete: NoAction)
  itineraryItem ItineraryItem?     @relation("ItineraryItemConflicts", fields: [tripId, itineraryItemId], references: [tripId, id], onDelete: NoAction)
  feedback      PlanningFeedback[] @relation("ConflictFeedback")

  @@unique([tripId, id])
  @@index([tripId])
  @@index([itineraryItemId])
  @@index([itineraryVersionId])
  @@index([type])
  @@index([severity])
  @@index([status])
  @@map("conflicts")
}
