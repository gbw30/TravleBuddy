generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum TripStatus {
  DRAFT
  PLANNING
  ARCHIVED
}

/// Who may see a trip. Private in the first version (TB-SYS-13). The owner is
/// Trip.userId; later stages add values here and a list of viewers.
enum TripVisibility {
  PRIVATE
}

enum Firmness {
  FIXED
  FLEXIBLE
}

enum BudgetBasis {
  TRIP
  DAY
}

enum PlanningMode {
  GUIDED
  QUICK
}

enum CommitmentKind {
  TRANSPORT
  STAY
  RESERVATION
  MUST_SEE
  OTHER
}

/// Where a saved place came from (TB-TRU-01).
enum PlaceOrigin {
  OSM
  SAMPLE
  USER
}

/// What happened to a card. Every one stays on record (TB-CRD-12).
enum CardAction {
  PRESENTED
  PICKED
  SAVED
  DISCARDED
}

enum MessageAuthor {
  AGENT
  TRAVELLER
}

enum TripLogisticsMode {
  FLEXIBLE
  TICKETED
}

enum TravelSegmentMode {
  FLIGHT
  TRAIN
  BUS
  CAR
  FERRY
  OTHER
}

model User {
  id            String    @id @default(dbgenerated("(gen_random_uuid())::text"))
  name          String?
  email         String?   @unique
  emailVerified DateTime? @map("email_verified")
  image         String?
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  accounts Account[]
  sessions Session[]
  trips    Trip[]
  profile  Profile?

  @@map("users")
}

model Account {
  id                String  @id @default(dbgenerated("(gen_random_uuid())::text"))
  userId            String  @map("user_id")
  type              String
  provider          String
  providerAccountId String  @map("provider_account_id")
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(dbgenerated("(gen_random_uuid())::text"))
  sessionToken String   @unique @map("session_token")
  userId       String   @map("user_id")
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

model Trip {
  id                    String            @id @default(dbgenerated("(gen_random_uuid())::text"))
  userId                String            @map("user_id")
  title                 String
  status                TripStatus        @default(DRAFT)
  destinationSearchText String?           @map("destination_search_text")
  departureCity         String?           @map("departure_city")
  departureCountry      String?           @map("departure_country")
  departureTimeZone     String?           @map("departure_time_zone")
  startDate             DateTime?         @map("start_date")
  endDate               DateTime?         @map("end_date")
  budgetAmount          Decimal?          @map("budget_amount") @db.Decimal(12, 2)
  budgetCurrency        String?           @map("budget_currency") @db.VarChar(3)
  logisticsMode         TripLogisticsMode @default(FLEXIBLE) @map("logistics_mode")
  visibility            TripVisibility    @default(PRIVATE)
  planningMode          PlanningMode?     @map("planning_mode")
  planFinishedAt        DateTime?         @map("plan_finished_at")
  lengthNights          Int?              @map("length_nights")
  /// A rough time of year as a month, 1 to 12, for trips without dates yet.
  timeOfYear            Int?              @map("time_of_year")
  adults                Int?
  children              Int?
  budgetBasis           BudgetBasis?      @map("budget_basis")
  datesFirmness         Firmness?         @map("dates_firmness")
  budgetFirmness        Firmness?         @map("budget_firmness")
  purpose               String?           @db.VarChar(120)
  planningRevision      Int               @default(0) @map("planning_revision")
  tripVersion           Int               @default(1) @map("trip_version")
  createdAt             DateTime          @default(now()) @map("created_at")
  updatedAt             DateTime          @updatedAt @map("updated_at")

  user                 User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  destinations         TripDestination[]
  commitments          FixedCommitment[]
  plan                 Plan?
  cardEvents           CardEvent[]
  conversation         Conversation?
  conversationMessages ConversationMessage[]
  profile              TripProfile?
  planningMutations    PlanningMutation[]

  @@index([userId])
  @@index([status])
  @@index([startDate, endDate])
  @@map("trips")
}

model TripDestination {
  id        String   @id @default(dbgenerated("(gen_random_uuid())::text"))
  tripId    String   @map("trip_id")
  city      String
  country   String
  region    String?
  timeZone  String?  @map("time_zone")
  latitude  Decimal? @db.Decimal(10, 7)
  longitude Decimal? @db.Decimal(10, 7)
  sortOrder Int      @default(0) @map("sort_order")
  nights    Int?
  notes     String?  @db.Text
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  trip Trip @relation(fields: [tripId], references: [id], onDelete: Cascade)

  @@unique([tripId, id])
  @@index([tripId])
  @@index([tripId, sortOrder])
  @@map("trip_destinations")
}

/// Something already decided: a ticket, a stay, a reservation, a must-see.
/// Dates and times are wall-clock values at the place, with no time zone.
model FixedCommitment {
  id                  String             @id @default(dbgenerated("(gen_random_uuid())::text"))
  tripId              String             @map("trip_id")
  kind                CommitmentKind
  title               String             @db.VarChar(160)
  date                DateTime?          @db.Date
  startTime           String?            @map("start_time") @db.VarChar(5)
  endDate             DateTime?          @map("end_date") @db.Date
  endTime             String?            @map("end_time") @db.VarChar(5)
  reference           String?            @db.VarChar(80)
  note                String?            @db.VarChar(500)
  transportMode       TravelSegmentMode? @map("transport_mode")
  origin              String?            @db.VarChar(120)
  destination         String?            @db.VarChar(120)
  /// The time zone of each end of a ticket, so its length is measured with both clocks.
  originTimeZone      String?            @map("origin_time_zone") @db.VarChar(64)
  destinationTimeZone String?            @map("destination_time_zone") @db.VarChar(64)
  /// Set only on a STAY whose found address the traveller confirmed.
  latitude            Decimal?           @db.Decimal(10, 7)
  longitude           Decimal?           @db.Decimal(10, 7)
  locatedRef          String?            @map("located_ref") @db.VarChar(80)
  locatedAddress      String?            @map("located_address") @db.VarChar(240)
  createdAt           DateTime           @default(now()) @map("created_at")
  updatedAt           DateTime           @updatedAt @map("updated_at")

  trip Trip @relation(fields: [tripId], references: [id], onDelete: Cascade)

  @@index([tripId, date])
  @@map("fixed_commitments")
}

/// A place saved from a provider, or entered by a traveller. OpenStreetMap's
/// licence allows keeping this data with credit (ADR-009, TB-SYS-12).
model Place {
  id            String      @id @default(dbgenerated("(gen_random_uuid())::text"))
  origin        PlaceOrigin
  /// The provider's own reference, such as "node/123". Null for a traveller's own place.
  originRef     String?     @map("origin_ref") @db.VarChar(80)
  /// The city this place was saved for: lower-case "name|country".
  cityKey       String      @map("city_key") @db.VarChar(170)
  name          String      @db.VarChar(160)
  kind          String      @db.VarChar(20)
  latitude      Decimal?    @db.Decimal(10, 7)
  longitude     Decimal?    @db.Decimal(10, 7)
  address       String?     @db.VarChar(240)
  /// As the provider wrote it. Null means unknown, never a guess.
  openingHours  String?     @map("opening_hours") @db.VarChar(400)
  /// Known beyond its neighbourhood: it has an encyclopedia entry.
  notable       Boolean     @default(false)
  /// Dietary rules its listing says it serves, such as "vegetarian".
  serves        String[]    @default([])
  /// Dietary rules its listing says it does not serve. Neither list: unknown.
  servesNot     String[]    @default([]) @map("serves_not")
  /// The OpenStreetMap tags its facts were read from, as they arrived (KEPT_TAGS only).
  osmTags       Json?       @map("osm_tags")
  /// The element's last edit on the map (Overpass `out meta`).
  lastEditedAt  DateTime?   @map("last_edited_at")
  /// When this row was last fetched. Null: fetched before provenance was kept.
  fetchedAt     DateTime?   @map("fetched_at")
  /// When a refresh that asks for it stopped returning it. Never offered on a card again; plans keep it.
  goneAt        DateTime?   @map("gone_at")
  /// The traveller who entered it. Set only when origin is USER.
  addedByUserId String?     @map("added_by_user_id")
  createdAt     DateTime    @default(now()) @map("created_at")
  updatedAt     DateTime    @updatedAt @map("updated_at")

  @@unique([origin, originRef])
  @@index([cityKey, kind])
  @@map("places")
}

/// One finished request to a place provider, so it is never repeated.
model PlaceFetch {
  id         String   @id @default(dbgenerated("(gen_random_uuid())::text"))
  cityKey    String   @map("city_key") @db.VarChar(170)
  /// "sights", or "food@35.72,139.78" for the food near one point.
  scope      String   @db.VarChar(40)
  placeCount Int      @map("place_count")
  fetchedAt  DateTime @default(now()) @map("fetched_at")

  @@unique([cityKey, scope])
  @@map("place_fetches")
}

/// Requests made to place providers each day, for the daily cap (TB-SYS-11).
model ProviderCall {
  day     DateTime @db.Date
  service String   @db.VarChar(20)
  count   Int      @default(0)

  @@id([day, service])
  @@map("provider_calls")
}

/// A saved address search, so the provider is asked once per distinct search
/// (Nominatim's policy). No user id: the key is the search and its square.
model AddressLookup {
  /// The normalised search and the square it was bounded to.
  key       String   @id @db.VarChar(200)
  results   Json
  createdAt DateTime @default(now()) @map("created_at")

  @@map("address_lookups")
}

/// The plan of a trip: a pointer to the version now in force.
model Plan {
  tripId          String  @id @map("trip_id")
  activeVersionId String? @map("active_version_id")
  /// Progress of a Quick plan build: the next day to build, what the build
  /// put where, and what it was unsure of. Null when no build was started.
  build           Json?

  trip     Trip          @relation(fields: [tripId], references: [id], onDelete: Cascade)
  versions PlanVersion[]

  @@map("plans")
}

/// One saved version of a plan. Versions are never changed; undo points the
/// plan back at the parent (ADR-001, TB-ITN-12).
model PlanVersion {
  id              String   @id @default(dbgenerated("(gen_random_uuid())::text"))
  tripId          String   @map("trip_id")
  version         Int
  parentVersionId String?  @map("parent_version_id")
  /// The traveller's choices, checked against a schema on every read and write.
  state           Json
  summary         String   @db.VarChar(200)
  createdAt       DateTime @default(now()) @map("created_at")

  plan Plan @relation(fields: [tripId], references: [tripId], onDelete: Cascade)

  @@unique([tripId, version])
  @@map("plan_versions")
}

/// A card shown to a traveller and what they did with it.
model CardEvent {
  id        String     @id @default(dbgenerated("(gen_random_uuid())::text"))
  tripId    String     @map("trip_id")
  slotId    String     @map("slot_id") @db.VarChar(40)
  placeId   String     @map("place_id")
  action    CardAction
  /// The reason given for a discard, from the common list.
  reason    String?    @db.VarChar(40)
  note      String?    @db.VarChar(300)
  createdAt DateTime   @default(now()) @map("created_at")

  trip Trip @relation(fields: [tripId], references: [id], onDelete: Cascade)

  @@index([tripId, action])
  @@map("card_events")
}

/// Saved city lookups, keyed by the normalised search text (ADR-009).
model CityLookup {
  query     String   @id @db.VarChar(120)
  results   Json
  createdAt DateTime @default(now()) @map("created_at")

  @@map("city_lookups")
}

model PlanningMutation {
  id                 String   @id @default(dbgenerated("(gen_random_uuid())::text"))
  tripId             String   @map("trip_id")
  operationId        String   @map("operation_id") @db.VarChar(128)
  kind               String   @db.VarChar(64)
  requestFingerprint String?  @map("request_fingerprint") @db.Char(64)
  requestedRevision  Int?     @map("requested_revision")
  resultingRevision  Int      @map("resulting_revision")
  resultVersion      Int      @default(1) @map("result_version")
  result             Json
  createdAt          DateTime @default(now()) @map("created_at")

  trip Trip @relation(fields: [tripId], references: [id], onDelete: Cascade)

  @@unique([tripId, operationId])
  @@index([tripId, createdAt])
  @@map("planning_mutations")
}

/// The guided conversation's own state for a trip (Conversation service).
model Conversation {
  tripId       String   @id @map("trip_id")
  /// Fact questions the traveller chose to skip, so they are not asked again.
  skippedFacts String[] @default([]) @map("skipped_facts")
  updatedAt    DateTime @updatedAt @map("updated_at")

  trip Trip @relation(fields: [tripId], references: [id], onDelete: Cascade)

  @@map("conversations")
}

/// One entry in a trip's saved conversation. The id gives the order: rows
/// written in one transaction share a timestamp.
model ConversationMessage {
  id        Int           @id @default(autoincrement())
  tripId    String        @map("trip_id")
  author    MessageAuthor
  /// A text, a question or a proposal; checked against messageBodySchema.
  body      Json
  createdAt DateTime      @default(now()) @map("created_at")

  trip Trip @relation(fields: [tripId], references: [id], onDelete: Cascade)

  @@index([tripId, id])
  @@map("conversation_messages")
}

/// What the traveller said about their taste for one trip (Memory service).
model TripProfile {
  tripId         String   @id @map("trip_id")
  /// Topic to answer: the values chosen and whether they were told or a default.
  taste          Json     @default("{}")
  /// Whether the traveller marked this trip as different from their usual.
  /// Null until they are asked. A trip marked different teaches the personal
  /// profile nothing through behaviour.
  differs        Boolean?
  /// Why it is different, in the traveller's words or one of the purposes.
  differsBecause String?  @map("differs_because") @db.VarChar(120)
  /// What the traveller typed under "anything else" in the trip brief, as
  /// typed. It affects nothing until a part of it is confirmed as an answer.
  said           String?  @db.VarChar(600)
  updatedAt      DateTime @updatedAt @map("updated_at")

  trip    Trip             @relation(fields: [tripId], references: [id], onDelete: Cascade)
  history ProfileHistory[]

  @@map("trip_profiles")
}

/// Tokens spent on the AI model in one calendar month, for the spending cap.
model AiUsage {
  /// "2026-11"
  month        String @id @db.VarChar(7)
  inputTokens  Int    @default(0) @map("input_tokens")
  outputTokens Int    @default(0) @map("output_tokens")
  calls        Int    @default(0)

  @@map("ai_usage")
}

/// A traveller's personal profile: what the site believes across trips
/// (Memory service). The row holds the profile's revision; entries, notes
/// and history hang from it.
model Profile {
  userId     String    @id @map("user_id")
  /// Goes up by one with every change; each history row names the revision it produced.
  revision   Int       @default(0)
  /// Set by a reset: trips finished before this moment teach nothing.
  learnAfter DateTime? @map("learn_after")
  updatedAt  DateTime  @updatedAt @map("updated_at")

  user      User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  entries   ProfileEntry[]
  notes     ProfileNote[]
  history   ProfileHistory[]
  forgotten ForgottenEvidence[]

  @@map("profiles")
}

/// One thing the site believes: a value on a topic, how sure, and from where.
model ProfileEntry {
  id              String   @id @default(dbgenerated("(gen_random_uuid())::text"))
  userId          String   @map("user_id")
  topic           String   @db.VarChar(30)
  value           String   @db.VarChar(80)
  /// "think", "usually" or "always".
  sureness        String   @db.VarChar(10)
  /// Null when the traveller said so; otherwise the most recent trip it was learned from.
  sourceTripId    String?  @map("source_trip_id")
  /// Kept as text, so the source can still be named after that trip is deleted.
  sourceTripTitle String?  @map("source_trip_title") @db.VarChar(120)
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  profile Profile @relation(fields: [userId], references: [userId], onDelete: Cascade)

  @@unique([userId, topic, value])
  @@map("profile_entries")
}

/// Something the traveller said that fits no topic. Kept and shown; not used by the ranking.
model ProfileNote {
  id        String   @id @default(dbgenerated("(gen_random_uuid())::text"))
  userId    String   @map("user_id")
  text      String   @db.VarChar(300)
  createdAt DateTime @default(now()) @map("created_at")

  profile Profile @relation(fields: [userId], references: [userId], onDelete: Cascade)

  @@index([userId])
  @@map("profile_notes")
}

/// Every change to a personal profile or a trip profile, in order. Append-only.
model ProfileHistory {
  id        Int      @id @default(autoincrement())
  /// Set for a change to a personal profile.
  userId    String?  @map("user_id")
  /// Set for a change to a trip profile.
  tripId    String?  @map("trip_id")
  /// The personal profile's revision this change produced.
  revision  Int?
  topic     String   @db.VarChar(30)
  /// The entry or answer before the change; null when there was none.
  before    Json?
  /// The entry or answer after the change; null when it was removed.
  after     Json?
  /// "traveller", "learning", "reset", "conversation" or "brief".
  cause     String   @db.VarChar(20)
  createdAt DateTime @default(now()) @map("created_at")

  profile     Profile?     @relation(fields: [userId], references: [userId], onDelete: Cascade)
  tripProfile TripProfile? @relation(fields: [tripId], references: [tripId], onDelete: Cascade)

  @@index([userId, id])
  @@index([tripId, id])
  @@map("profile_history")
}

/// A learned entry the traveller deleted, with the trips it had come from.
/// Those trips no longer count for that value.
model ForgottenEvidence {
  id      String   @id @default(dbgenerated("(gen_random_uuid())::text"))
  userId  String   @map("user_id")
  topic   String   @db.VarChar(30)
  value   String   @db.VarChar(80)
  tripIds String[] @default([]) @map("trip_ids")

  profile Profile @relation(fields: [userId], references: [userId], onDelete: Cascade)

  @@unique([userId, topic, value])
  @@map("forgotten_evidence")
}

/// Fair use (Fair use service): requests and spend counted per person in
/// fixed windows (TB-SYS-16, TB-SYS-17). `key` names the limit and one of the
/// person's identifiers, as "api:a:<user id>", "api:d:<device id>" or
/// "gather:s:<signature>". No relation to users: a device or a signature is
/// not a user. A window is deleted once it has ended.
model FairUseCount {
  key    String   @db.VarChar(100)
  /// When the window ends: the next minute, or the next UTC midnight.
  endsAt DateTime @map("ends_at") @db.Timestamptz(3)
  count  Int      @default(0)

  @@id([key, endsAt])
  @@index([endsAt])
  @@map("fair_use_counts")
}
