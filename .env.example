# Local development example.
# Copy this file to .env.local or .env and replace placeholders with real values.
# Never commit real Neon credentials or API keys.

# Neon pooled connection string.
# Use this for the running application in serverless environments.
DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/DB_NAME?sslmode=require"

# Neon direct connection string.
# Use this for Prisma CLI commands and migrations.
DIRECT_URL="postgresql://USER:PASSWORD@HOST.REGION.aws.neon.tech/DB_NAME?sslmode=require"

# Auth.js / NextAuth v5-style variables for the Phase 3 setup.
AUTH_SECRET="replace-with-a-long-random-local-secret"
# Optional. Usually leave unset on Vercel so Auth.js infers the active deployment host.
AUTH_URL="http://localhost:3000"
# Optional. Use a stable production auth route for Vercel preview OAuth callbacks.
AUTH_REDIRECT_PROXY_URL="https://your-production-domain.com/api/auth"
AUTH_GOOGLE_ID="replace-with-google-oauth-client-id"
AUTH_GOOGLE_SECRET="replace-with-google-oauth-client-secret"

# Legacy aliases are local migration aids only. Phase 3 uses AUTH_* names.
NEXTAUTH_SECRET="replace-with-a-long-random-local-secret"
NEXTAUTH_URL="http://localhost:3000"
GOOGLE_CLIENT_ID="replace-with-google-oauth-client-id"
GOOGLE_CLIENT_SECRET="replace-with-google-oauth-client-secret"

GEMINI_API_KEY="replace-with-your-local-dev-key"
GOOGLE_MAPS_API_KEY="replace-with-your-local-dev-key"
GOOGLE_PLACES_API_KEY="replace-with-your-local-dev-key"
GOOGLE_ROUTES_API_KEY="replace-with-your-local-dev-key"

# Isolated QA automation. Never point writable QA commands at production.
QA_TARGET="local"
QA_BASE_URL="http://127.0.0.1:3000"
QA_RUN_ID="qa-local-example"
QA_ALLOW_WRITES="false"
# Run `npm run qa:fingerprint` only after DATABASE_URL/DIRECT_URL points to the
# dedicated disposable local or preview QA database, then copy its digest here.
QA_DATABASE_FINGERPRINT="replace-with-the-64-character-sha256-digest"
QA_ACTIVE_STAGE="current"
QA_PROVIDER_MODE="mock"
# Agent routing. PR runs require QA_BASE_SHA for selective routing; a missing
# base safely selects the full team. QA_FORCE_AGENTS only adds PR reviewers.
QA_RUN_TYPE="pr"
# QA_BASE_SHA="0123456789abcdef0123456789abcdef01234567"
QA_FORCE_AGENTS=""
# Use read-only when bundles will be consumed by Codex in CI.
QA_PARENT_SANDBOX="workspace-write"
# Optional protected Vercel deployment bypass used only by Playwright request
# headers. Keep the real value in the qa-preview/qa-release environment secret.
# VERCEL_AUTOMATION_BYPASS_SECRET="replace-with-protected-vercel-secret"

# Optional deny-list guard. Set this to the credential-free fingerprint of the
# production database in protected QA environments. QA writes fail if it matches.
# QA_PRODUCTION_DATABASE_FINGERPRINT="replace-with-production-sha256-digest"

# Production smoke uses QA_TARGET=production-readonly, QA_ALLOW_WRITES=false,
# and a protected pre-provisioned Auth.js cookie. Do not store that cookie here.
