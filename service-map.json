{
  "services": {
    "identity": {
      "code": [
        "src/lib/auth.ts",
        "src/lib/auth-policy.ts",
        "src/lib/auth-routes.ts",
        "src/lib/authorization.ts",
        "src/lib/authorization-rules.ts"
      ],
      "tables": ["User", "Account", "Session", "VerificationToken"]
    },
    "trips": {
      "code": ["src/features/trips/**"],
      "tables": ["Trip", "TripDestination", "FixedCommitment"]
    },
    "conversation": {
      "code": ["src/features/conversation/**", "src/features/planning/**"],
      "tables": [
        "PlanningMutation",
        "Conversation",
        "ConversationMessage",
        "AiUsage",
        "WordingRecord"
      ]
    },
    "memory": {
      "code": ["src/features/memory/**"],
      "tables": [
        "TripProfile",
        "Profile",
        "ProfileEntry",
        "ProfileNote",
        "ProfileHistory",
        "ForgottenEvidence"
      ]
    },
    "places": {
      "code": ["src/features/places/**"],
      "tables": [
        "AddressLookup",
        "CityLookup",
        "Place",
        "PlaceFetch",
        "ProviderCall"
      ]
    },
    "recommendations": {
      "code": ["src/features/recommendations/**"],
      "tables": ["CardEvent"]
    },
    "itinerary": {
      "code": ["src/features/itinerary/**"],
      "tables": ["Plan", "PlanVersion"]
    },
    "fair-use": {
      "code": ["src/features/fair-use/**"],
      "tables": ["FairUseCount"]
    }
  },
  "crossBorderForeignKeys": [
    "CardEvent.trip -> Trip (recommendations -> trips)",
    "Conversation.trip -> Trip (conversation -> trips)",
    "ConversationMessage.trip -> Trip (conversation -> trips)",
    "Plan.trip -> Trip (itinerary -> trips)",
    "PlanningMutation.trip -> Trip (conversation -> trips)",
    "Profile.user -> User (memory -> identity)",
    "Trip.user -> User (trips -> identity)",
    "TripProfile.trip -> Trip (memory -> trips)",
    "WordingRecord.trip -> Trip (conversation -> trips)"
  ]
}
